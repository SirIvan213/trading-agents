# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Proxies: HTTPS_PROXY / HTTP_PROXY / NO_PROXY are honoured by every data request. A proxy
# sees the full URLs and the headers (Alpaca and FMP keys, the SEC user agent): only set one
# you trust.
# SEC EDGAR asks every client to identify itself
SEC_USER_AGENT="Your Name you@example.com"
# Financial Modeling Prep earnings calendar (event gate, #112). Billed per call on FMP's side;
# the first live call needs Ivan's approval (CLAUDE.md rule 6). See README, "Earnings calendar".
FMP_API_KEY=

# --- Optional agent settings (all unset by default) ---
# Model and effort for ALL agents. Effort is one of: low, medium, high, xhigh, max.
# Defaults: model claude-sonnet-5-5 (claude-opus-5-5 for the trader), effort high.
# TRADING_AGENTS_MODEL=
# TRADING_AGENTS_EFFORT=
# Per-agent overrides, which win over the two above. <AGENT> is one of:
# TECHNICAL, SENTIMENT, FUNDAMENTALS, BULL, BEAR, TRADER
# TRADING_AGENTS_<AGENT>_MODEL=
# TRADING_AGENTS_<AGENT>_EFFORT=
# Bull/Bear debate rounds, a whole number from 1 to 5 (default 2).
# TRADING_AGENTS_DEBATE_ROUNDS=
